#!/bin/bash
# .githooks/pre-commit
# Purpose: Validate code quality before every commit
# Runs: Automatically before git commit
# Blocks commit if: ShellCheck errors, YAML errors, secrets found, large files

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Track overall result
ERRORS=0

echo -e "${CYAN}🔍 Running pre-commit checks...${NC}"
echo ""

# =============================================================================
# CHECK 1 — ShellCheck on all staged .sh files
# =============================================================================
echo -e "${CYAN}[1/4] ShellCheck — bash script analysis${NC}"

# Get list of staged .sh files only
STAGED_SH=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)

if [[ -z "${STAGED_SH}" ]]; then
    echo -e "  ${GREEN}✅ No shell scripts staged${NC}"
else
    if command -v shellcheck &>/dev/null; then
        while IFS= read -r file; do
            if shellcheck "${file}"; then
                echo -e "  ${GREEN}✅ ${file}${NC}"
            else
                echo -e "  ${RED}❌ ${file} — ShellCheck failed${NC}"
                ERRORS=$((ERRORS + 1))
            fi
        done <<< "${STAGED_SH}"
    else
        echo -e "  ${YELLOW}⚠️  ShellCheck not installed — skipping${NC}"
        echo -e "  ${YELLOW}   Install: sudo apt install shellcheck${NC}"
    fi
fi

echo ""

# =============================================================================
# CHECK 2 — yamllint on all staged .yml/.yaml files
# =============================================================================
echo -e "${CYAN}[2/4] yamllint — YAML syntax validation${NC}"

STAGED_YAML=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yml|yaml)$' || true)

if [[ -z "${STAGED_YAML}" ]]; then
    echo -e "  ${GREEN}✅ No YAML files staged${NC}"
else
    if command -v yamllint &>/dev/null; then
        while IFS= read -r file; do
            if yamllint -d relaxed "${file}" &>/dev/null; then
                echo -e "  ${GREEN}✅ ${file}${NC}"
            else
                echo -e "  ${RED}❌ ${file} — YAML validation failed${NC}"
                yamllint -d relaxed "${file}"
                ERRORS=$((ERRORS + 1))
            fi
        done <<< "${STAGED_YAML}"
    else
        echo -e "  ${YELLOW}⚠️  yamllint not installed — skipping${NC}"
        echo -e "  ${YELLOW}   Install: pip install yamllint${NC}"
    fi
fi

echo ""

# =============================================================================
# CHECK 3 — Secret detection in staged files
# =============================================================================
echo -e "${CYAN}[3/4] Secret detection — scanning for credentials${NC}"

# Patterns that indicate secrets
SECRET_PATTERNS=(
    "password\s*=\s*['\"][^'\"]{4,}"
    "secret\s*=\s*['\"][^'\"]{4,}"
    "api_key\s*=\s*['\"][^'\"]{4,}"
    "token\s*=\s*['\"][^'\"]{4,}"
    "private_key"
    "BEGIN RSA PRIVATE KEY"
    "BEGIN OPENSSH PRIVATE KEY"
    "AKIA[0-9A-Z]{16}"
    "ghp_[a-zA-Z0-9]{36}"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)
SECRET_FOUND=false

if [[ -n "${STAGED_FILES}" ]]; then
    while IFS= read -r file; do
        # Skip binary files
        if file "${file}" | grep -q "binary"; then
            continue
        fi

        for pattern in "${SECRET_PATTERNS[@]}"; do
            if git diff --cached "${file}" | grep -iE "${pattern}" &>/dev/null; then
                echo -e "  ${RED}❌ Possible secret in ${file}: pattern '${pattern}'${NC}"
                SECRET_FOUND=true
                ERRORS=$((ERRORS + 1))
            fi
        done
    done <<< "${STAGED_FILES}"
fi

if [[ "${SECRET_FOUND}" == false ]]; then
    echo -e "  ${GREEN}✅ No secrets detected${NC}"
fi

echo ""

# =============================================================================
# CHECK 4 — Large file detection
# =============================================================================
echo -e "${CYAN}[4/4] Large file check — nothing over 5MB${NC}"

MAX_SIZE=$((5 * 1024 * 1024))  # 5MB in bytes

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)

if [[ -n "${STAGED_ALL}" ]]; then
    while IFS= read -r file; do
        if [[ -f "${file}" ]]; then
            FILE_SIZE=$(stat -c%s "${file}" 2>/dev/null || echo 0)
            if [[ "${FILE_SIZE}" -gt "${MAX_SIZE}" ]]; then
                FILE_SIZE_MB=$(echo "scale=1; ${FILE_SIZE}/1048576" | bc)
                echo -e "  ${RED}❌ ${file} is ${FILE_SIZE_MB}MB — exceeds 5MB limit${NC}"
                ERRORS=$((ERRORS + 1))
            fi
        fi
    done <<< "${STAGED_ALL}"
fi

echo -e "  ${GREEN}✅ All files within size limit${NC}"
echo ""

# =============================================================================
# RESULT
# =============================================================================
if [[ "${ERRORS}" -gt 0 ]]; then
    echo -e "${RED}❌ Pre-commit checks FAILED — ${ERRORS} error(s) found${NC}"
    echo -e "${RED}   Fix the issues above and try again${NC}"
    echo -e "${YELLOW}   To skip hooks (emergency only): git commit --no-verify${NC}"
    exit 1
else
    echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
    exit 0
fi
